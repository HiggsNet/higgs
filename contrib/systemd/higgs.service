[Unit]
Description=Higgs mesh daemon
After=network-online.target strongswan.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
Environment=HIGGS_CONFIG=/etc/higgs/config.yaml
ExecStart=/usr/local/bin/higgs daemon
Restart=on-failure
RestartSec=2s
RuntimeDirectory=higgs
RuntimeDirectoryMode=0700
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
