[Unit]
Description=Photon admin daemon
Documentation=https://github.com/HiggsNet/photon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
Environment=PHOTON_ADMIN_CONFIG=/etc/photon/admin/config.yaml
Environment=PHOTON_ADMIN_STATE=/etc/photon/admin/photon.db
Environment=PHOTON_ADMIN_CONTROL_SOCKET=/run/photon-admin/photon.sock
ExecStart=/usr/local/bin/photon-admin daemon
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s
RuntimeDirectory=photon-admin
RuntimeDirectoryMode=0700
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
